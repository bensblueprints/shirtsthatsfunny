# ─── Shirt That's Funny — stack configuration ────────────────────────────────
# Copy to .env and edit. Every service reads from here; change SITE_DOMAIN and
# the whole stack follows.

SITE_DOMAIN=shirtthatsfunny.com
SITE_TITLE=Shirt That's Funny

# In dev these point at localhost. In prod, run scripts/switch-to-prod.sh
# (or just set them to https://${SITE_DOMAIN} and https://cms.${SITE_DOMAIN}).
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_CMS_URL=http://localhost:8080

# ─── Database ───────────────────────────────────────────────────────────────
MYSQL_DATABASE=shirtthatsfunny
MYSQL_USER=stf
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ─── WordPress admin (created by the bootstrap container) ───────────────────
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-admin-password
WP_ADMIN_EMAIL=ben@advancedmarketing.co

# ─── WooCommerce REST API (read-only key used by Next.js server-side) ───────
# Generate fresh values before going live:
#   openssl rand -hex 20 | sed 's/^/ck_/'
#   openssl rand -hex 20 | sed 's/^/cs_/'
WC_CONSUMER_KEY=ck_0000000000000000000000000000000000000000
WC_CONSUMER_SECRET=cs_0000000000000000000000000000000000000000

# ─── Storefront ─────────────────────────────────────────────────────────────
# Signs the cart-token cookie. openssl rand -hex 32
SESSION_SECRET=change-me-session-secret

# Exit-intent popup coupon (created in Woo by the bootstrap container)
NEXT_PUBLIC_EXIT_COUPON=FUNNY10
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=65

# ─── Stripe (live keys; publishable is safe to expose, secret stays server-side) ─
STRIPE_PUBLISHABLE_KEY=pk_live_0000000000000000000000000000000000000000000000

# ─── Ports (host side) ──────────────────────────────────────────────────────
WEB_PORT=3000
CMS_PORT=8080
MAILPIT_PORT=8025

# ─── Printful (print-on-demand fulfilment) ─────────────────────────────────
# Paste into WooCommerce -> Printful -> Connect after first boot.
PRINTFUL_API_TOKEN=your-printful-api-token
